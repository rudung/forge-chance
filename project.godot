; Engine configuration file.
; Godot 4.x project
config_version=5

[application]
config/name="강화 대장간 v1.1"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")\nconfig/icon="res://assets/coin.svg"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.015, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
